{
    "$schema": "https://typedoc.org/schema.json",
    "tsconfig": "tsconfig_root_compile.json",
    "name": "Jivs",
    "entryPoints": [
        "packages/jivs-engine/src/",
        "packages/jivs-builder/src/",
        "packages/jivs-configanalysis/src/",
        "docs/Home.md",
        "docs/Terminology.md"
    ],
    "readme": "typedoc/EntryPoint.md",
    "projectDocuments": [
        "docs/Terminology.md"
    ],
    "entryPointStrategy": "expand",
    "exclude": [
        "**/*.js",
        "**/*.js.map",
        "**/*.d.ts"
    ],
    "out": "typedoc_output",
    "useTsLinkResolution": true,
    "customCss": "typedoc/jivstheme.css",
    "excludePrivate": true,
    "plugin": ["typedoc-plugin-extras", "typedoc-plugin-merge-modules"],
    //NOTE: Plugin for mermaid, typedoc-plugin-mermaid, is not used because it does not render correctly for our diagrams in markdown
    "customTitle": "Jivs Complete API",          //typedoc-plugin-extras
    "footerTypedocVersion": true,   //typedoc-plugin-extras
    "footerLastModified": true,      //typedoc-plugin-extras
    "mergeModulesRenameDefaults": false, // typedoc-plugin-merge-modules
    "mergeModulesMergeMode": "module",   // typedoc-plugin-merge-modules
    "sortEntryPoints": false,
    "sort": [
        "kind",
        "instance-first",
        "source-order"
    ],
    "highlightLanguages": ["ts", "js", "html", "css", "json", "bash", "xml", "yaml", "mermaid", "http"]
}  