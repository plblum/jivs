// This file is intended only for the typedoc process to use.
// With typedoc, we want to include several packages.
// Typedoc uses a tsconfig file for that purpose. 
// The typedoc.json file points to this file.
{
    "extends":  "./tsconfig_common.json",
    "compilerOptions":
    {
        "baseUrl": ".",
        "outDir": "./global_build/",
        "rootDir": "./",
        "declarationDir": "./global_build/types",    
        "paths": {
          "@plblum/jivs-engine": ["./packages/jivs-engine"],
          "@plblum/jivs-builder": ["./packages/jivs-builder"]
        },
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true
    },    
    "include": [
      "packages/jivs-engine",
      "packages/jivs-builder",
      "packages/jivs-configanalysis"
    ],
    "exclude": [ 
        "./*.js", 
        "./*.mjs", 
        "coverage",
        "node_modules",
        "docs",
        "starter_code",
        "typedoc",
        "typedoc_output",
        "packages/*/build",
        "packages/*/tests",
        "packages/*/coverage",
        "packages/*/node_modules",
        "packages/*/examples",
        "packages/*/planning",
        "planning"]
}