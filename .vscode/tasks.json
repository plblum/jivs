{
    "version": "2.0.0",
    "tasks": [
        {
            // Starts the Vite dev server for launch configurations, and stays running in the background.
            "label": "jivs-ui-demos: dev server",
            "type": "shell",
            "command": "npx vite --port 5173 --strictPort",
            "options": { "cwd": "${workspaceFolder}/packages/jivs-ui-demos" },
            "isBackground": true,
            "problemMatcher": {
                "owner": "vite",
                "pattern": { "regexp": "^$" },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "VITE",
                    "endsPattern": "Local:"
                }
            },
            "presentation": { "reveal": "silent", "panel": "dedicated" }
        }
    ]
}
